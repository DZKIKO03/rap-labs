//Managed behavior: RAP framework handles persistence lifecycle
//Unique implementation class per BO root, avoids ambiguity in save sequence
managed implementation in class ZEQUBP_R_EQUIPMENT unique;
//" Enforces RAP strict mode level 2:
//" - no implicit behavior
//" - explicit lifecycle control
//" - compile-time checks for clean RAP usage
//" Required for cloud-ready and future-proof design
strict ( 2 );
//" Enables draft handling for transactional consistency and Fiori UX
//" Allows edit, validation, and save phases separation
with draft;
//" Allows future extensions (fields, logic) without modifying core behavior
//" Aligns with Clean Core and extensibility principles
extensible;
define behavior for ZEQUR_EQUIPMENT alias ZequrEquipment
//" Main persistence table for Equipment business object
persistent table zequipment
extensible
//" Draft persistence table managed by RAP runtime
draft table zequequipment_d
//" Optimistic locking using timestamp
//" Prevents lost updates in concurrent scenarios
etag master LocalLastChangedAt
//" Total lock on root entity
//" Ensures consistency across root and child during save
lock master total etag LocalLastChangedAt
//" Authorization handled at root level
//" Placeholder for global authorization logic
authorization master ( global )
//" Business key generated during save
//" Required when using number ranges or external ID logic
late numbering
//" Ensures full data availability during save sequence
//" Needed for cross-entity logic (Equipment affecting Orders)
with additional save with full data

{
//" System-controlled fields
//" Protected from UI and external modification
  field ( readonly )
  EquiID,
  CreatedBy,
  CreatedAt,
  LocalLastChangedBy,
  LocalLastChangedAt;

//" Mandatory business attributes
//" Enforced by RAP framework during validation
  field ( mandatory )
  Description,
  Category;


//" Allows creation of Equipment instances
  create;
//" Update and delete controlled dynamically via instance feature control
//" Enables business-rule-driven enablement
  update ( features : instance );
  delete ( features : instance );

//" IsActive editability controlled dynamically
//" Depends on Equipment state and related Orders
  field ( features : instance ) IsActive;

//" Sets default value for IsActive during creation
//" Business defaulting logic, not UI responsibility
  determination set_default_isactive on modify
  { create;
  }

//" Ensures Category value is valid against reference data
//" Executed at save time to protect data integrity
  validation validate_category on save
  {
    field Category;
  }

//" Warning validation:
//" Deactivating Equipment with existing Orders triggers user warning
//" Does not block save, improves UX awareness
  validation warn_isactive on save { field IsActive; }

//" Enforces business consistency:
//" When Equipment is deactivated, related open Orders are cancelled
//" Strong business invariant implemented at save phase
  determination cancel_order on save
  {
    field IsActive;
  }


  side effects
  {
//" Changing IsActive may affect other fields and UI state
    field IsActive affects $self;
// " Triggers prepare phase to re-evaluate validations and messages
    determine action prepare
    executed on field IsActive
    affects messages;
  }
//" Standard draft lifecycle actions managed by RAP runtime
  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
//" Prepare phase validations executed before save
//" Ensures early feedback during draft handling
  draft determine action Prepare
  {
    validation validate_category;
    validation warn_isactive;
  }

//" Explicit field mapping between CDS entity and persistence table
//" Improves clarity and avoids implicit assumptions
  mapping for zequipment corresponding extensible
    {
      EquiID             = equi_id;
      Description        = description;
      Category           = category;
      SerialNumb         = serial_numb;
      Location           = location;
      IsActive           = is_active;
      CreatedBy          = created_by;
      CreatedAt          = created_at;
      LocalLastChangedBy = local_last_changed_by;
      LocalLastChangedAt = local_last_changed_at;
    }
//" Composition-like association to Maintenance Orders
//" Order creation allowed only when instance features permit
//" Draft-enabled to maintain transactional consistency
  association _ORDER { create ( features : instance ); with draft; }

}

//" Behavior definition for Maintenance Order child entity
//" Represents transactional orders linked to Equipment
define behavior for ZORDR_ORDER_MAN000 alias ZordrOrderMan000
//" Unique behavior handler for Order entity
//" Ensures deterministic behavior handling
implementation in class ZORDBP_R_ORDER_MAN unique
//" Main persistence table for Maintenance Orders
persistent table zorder_man
//" Draft persistence table for Order entity
//" Required because root Equipment is draft-enabled
draft table zordorder_man_d
//" Optimistic locking using timestamp
//" Prevents concurrent update conflicts
etag master LocalLastChangedAt
//" Locking delegated to parent Equipment
//" Ensures consistency across root and child during save
lock dependent by _equi
//" Authorization inherited from parent Equipment
//" Centralizes access control at root level
authorization dependent by _equi
//" OrderID generated during save phase
//" Allows number range based business keys
late numbering
//" Full data available during save
//" Required for status transitions and date updates
with additional save with full data
{
//" System and lifecycle controlled fields
//" Protected from direct modification
  field ( readonly )
  OrderID,
  EquipmentID,
  status,
  CreationDate,
  CompletionDate,
  CreatedBy,
  CreatedAt,
  LocalLastChangedBy,
  LocalLastChangedAt;
//" Mandatory business input fields
//" Enforced during create and save
  field ( mandatory )
  Description,
  ReportedBy;
//" Business action to release an order
//" Moves order from Created to Released state
  action ( features : instance ) releaseOrder result [1] $self;
//" Business action to complete an order
//" Finalizes order lifecycle and sets completion date
  action ( features : instance ) completedOrder result [1] $self;
//" Business action to cancel an order
//" Terminates order without completion
  action ( features : instance ) cancelledOrder result [1] $self;

//" Update and delete operations controlled dynamically
//" Enabled or disabled based on order status
  update ( features : instance );
  delete ( features : instance );

//" Sets default priority during order creation
//" Business defaulting logic
  determination set_priority on modify { create; }
//" Initializes lifecycle fields such as status and creation date
//" Ensures consistent initial state
  determination set_defaults on modify { create; }


//" Explicit mapping between CDS entity and persistence table
//" Improves maintainability and avoids implicit coupling
  mapping for zorder_man corresponding
    {
      OrderID            = order_id;
      EquipmentID        = equipment_id;
      Priority           = priority;
      Status             = status;
      ReportedBy         = reported_by;
      Description        = description;
      CreationDate       = creation_date;
      CompletionDate     = completion_date;
      CreatedBy          = created_by;
      CreatedAt          = created_at;
      LocalLastChangedBy = local_last_changed_by;
      LocalLastChangedAt = local_last_changed_at;
    }
//" Association back to parent Equipment
//" Draft-enabled to align with root draft lifecycle
  association _equi { with draft; }

}
