@EndUserText.label: 'Access control'
@MappingRole: true
define role Z017_R_TRAVEL {
    grant 
        select
            on
                Z017_R_TRAVEL
                    where
                        (AgencyId) = aspect pfcg_auth
                        ( /LRN/AGCY, 
                          /LRN/AGCY, 
                        ACTVT = '03' );
                        
}
