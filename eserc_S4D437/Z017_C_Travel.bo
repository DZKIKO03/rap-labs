projection;
strict ( 2 );
use draft;
use side effects;
extensible;
define behavior for Z017_C_Travel alias travel
use etag
extensible
{
  use create;
  use update;
  //  use delete;
  use action Activate;
  use action Discard;
  use action Edit;
  use action Prepare;
  use action Resume;

  use association _TravelItem { create; with draft; }
  use action cancel_travel;

  use action checkCustomer;

  use action adjustDuration;


}



define behavior for Z017_C_TravelItem alias item
use etag
extensible
{

  use update;
  use delete;
  use association _Travel { with draft; }

}
